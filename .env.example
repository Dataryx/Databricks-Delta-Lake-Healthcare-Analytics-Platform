# Indominus Health Research Consortium — Healthcare Lakehouse
# Copy to .env and fill values. NEVER commit .env.
# Cloud credentials must come from Azure Key Vault / Databricks secret scopes.

# Runtime mode: local | databricks
HC_RUNTIME_MODE=local

# Local Delta root (created by `make demo`)
HC_LOCAL_DELTA_ROOT=.local_delta

# Catalog / environment (Unity Catalog names; local mode uses as namespace prefixes)
HC_ENV=dev
HC_CATALOG=hc_dev
HC_ORG=INDHC
HC_AZURE_REGION=eastus2
HC_UC_METASTORE=uc_metastore_eastus2
HC_STORAGE_ACCOUNT=stindominushclake

# Small-cell suppression threshold for aggregate serving views
HC_SMALL_CELL_K=11

# Audit / retention (years)
HC_RETENTION_YEARS=7

# De-identification: LOCAL DEMO SALT ONLY — production salt lives in Key Vault
# secret scope `hc-secrets` key `deid-hmac-pepper`. Never use this value in cloud.
HC_DEID_SALT=local-demo-pepper-not-for-production

# Optional Databricks Connect / workspace (cloud mode)
# DATABRICKS_HOST=https://adb-xxxx.azuredatabricks.net
# DATABRICKS_TOKEN=  # prefer OAuth / SP; do not commit tokens
# DATABRICKS_CLUSTER_ID=

# Alert webhooks (optional; cloud-only features degrade gracefully)
# HC_ALERT_TEAMS_WEBHOOK=
# HC_ALERT_EMAIL_WEBHOOK=

# Logging
HC_LOG_LEVEL=INFO
HC_LOG_FORMAT=json
