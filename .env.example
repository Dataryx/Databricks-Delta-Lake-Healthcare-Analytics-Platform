# Local environment template for the INDHC lakehouse.
# Copy to .env and adjust. Never commit .env.
# Cloud secrets belong in Azure Key Vault / Databricks secret scopes.

# local | databricks
HC_RUNTIME_MODE=local

# Where local Delta tables are written
HC_LOCAL_DELTA_ROOT=.local_delta

HC_ENV=dev
HC_CATALOG=hc_dev
HC_ORG=INDHC
HC_AZURE_REGION=eastus2
HC_UC_METASTORE=uc_metastore_eastus2
HC_STORAGE_ACCOUNT=stindominushclake

# Suppress aggregate cells smaller than this (research disclosure)
HC_SMALL_CELL_K=11

# Audit retention in years
HC_RETENTION_YEARS=7

# LOCAL DEMO ONLY. Production pepper comes from secret scope hc-secrets / deid-hmac-pepper.
HC_DEID_SALT=local-demo-pepper-not-for-production

# Optional workspace settings for cloud / Connect
# DATABRICKS_HOST=https://adb-xxxx.azuredatabricks.net
# DATABRICKS_TOKEN=
# DATABRICKS_CLUSTER_ID=

# HC_ALERT_TEAMS_WEBHOOK=
# HC_ALERT_EMAIL_WEBHOOK=

HC_LOG_LEVEL=INFO
HC_LOG_FORMAT=json
